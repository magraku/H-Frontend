+          {arms.map((d, i) => (
+            <path key={i} d={d} className="tentacle" strokeDasharray="1 7" style={{ transformOrigin: i < 4 ? "100% 0%" : "0% 0%", animationDelay: `${-i * 0.45}s` }} />
